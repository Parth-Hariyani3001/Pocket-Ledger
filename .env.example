# Required at build time. On Cloudflare, set these as build variables
# (Workers & Pages → your project → Settings → Variables and Secrets).
VITE_SUPABASE_KEY=
VITE_SUPABASE_URL=
# Supabase project ref from the dashboard URL. Used by npm run generate-types, not the production build.
PROJECT_ID=
# Optional. OAuth uses this URL when set; otherwise it returns to the current site origin.
# Add each deployed origin under Supabase Auth → URL Configuration → Redirect URLs.
VITE_OAUTH_REDIRECT_URL=